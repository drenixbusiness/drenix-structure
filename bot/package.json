{
  "name": "drenix-assistant-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Drenix HR assistant: job requests + AI executive assistant on Telegram",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "google:auth": "tsx src/google/auth-cli.ts",
    "google:auth:prod": "node dist/google/auth-cli.js",
    "chat": "tsx src/cli/chat.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.14.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "grammy": "^1.46.0",
    "openai": "^7.43.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
